# ==============================================================================
# SVANT - Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# Real credentials and secrets must NEVER be committed to Git.
# ==============================================================================

# Core Application Settings
SVANT_ENV=development
SVANT_HOST=127.0.0.1
SVANT_PORT=8000
SVANT_LOG_LEVEL=INFO

# Storage & Data Paths
# Persistent data directory (SQLite DB, logs, future search indices/embeddings)
# Defaults to D:\SVANTData on Windows when available, or ./data as fallback
SVANT_DATA_DIR=D:\SVANTData

# Scanner & Indexing Limits
# Maximum file size to attempt full text extraction for (in Megabytes)
SVANT_MAX_EXTRACT_SIZE_MB=15
# Excluded directory patterns separated by comma
SVANT_EXCLUDED_DIRS=.git,.venv,venv,node_modules,dist,build,__pycache__,.pytest_cache,.idea,.vscode,.mypy_cache

# Privacy & Security Settings
# When true, project files are never sent over the network
SVANT_LOCAL_ONLY_MODE=true

# Future Phase Placeholders (Inactive in Phase 1)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# EMBEDDING_PROVIDER=local
