# ==============================================================================
# SVANT - Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# Real credentials and secrets must NEVER be committed to Git.
# ==============================================================================

# Core Application Settings
SVANT_ENV=development
SVANT_HOST=127.0.0.1
SVANT_PORT=8000
SVANT_LOG_LEVEL=INFO

# Storage & Data Paths
# Persistent data directory (SQLite DB, logs, FAISS indexes, local embedding models)
# Defaults to D:\SVANTData on Windows when available, or ./data as fallback
SVANT_DATA_DIR=D:\SVANTData

# Scanner & Extraction Limits
# Maximum file size to attempt full text extraction for (in Megabytes)
SVANT_MAX_EXTRACT_SIZE_MB=15
# Excluded directory patterns separated by comma
SVANT_EXCLUDED_DIRS=.git,.venv,venv,node_modules,dist,build,__pycache__,.pytest_cache,.idea,.vscode,.mypy_cache

# Local Embedding & Search Settings
SVANT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SVANT_EMBEDDING_BATCH_SIZE=32
SVANT_CHUNK_SIZE=500
SVANT_CHUNK_OVERLAP=50
SVANT_HYBRID_SEMANTIC_WEIGHT=0.6
SVANT_HYBRID_KEYWORD_WEIGHT=0.4

# Privacy & Security Settings
# When true, SVANT operates in 100% offline Local-Only mode (no external calls made)
SVANT_LOCAL_ONLY_MODE=true

# AI Assistant & Grounded Chat Settings
# AI Provider: "gemini" (cloud generation), "mock" (offline testing), or "local" (context citations only)
SVANT_AI_PROVIDER=gemini

# Google Gemini API Configuration (Optional: only needed when SVANT_LOCAL_ONLY_MODE=false)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
SVANT_GEMINI_API_KEY=
SVANT_GEMINI_MODEL=gemini-2.5-flash

# RAG Context & Retrieval Tuning
SVANT_RAG_TOP_K=8
SVANT_RAG_MAX_CONTEXT_CHARS=30000
SVANT_AI_TIMEOUT_SECONDS=30.0

